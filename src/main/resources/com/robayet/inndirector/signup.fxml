<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #ffdecd;" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.robayet.inndirector.Controller.SignupController">
   <children>
      <Label alignment="CENTER" layoutX="1.0" layoutY="14.0" prefHeight="39.0" prefWidth="900.0" text="Create New Account">
         <font>
            <Font name="System Bold" size="20.0" />
