      </Label>
      <Label layoutX="347.0" layoutY="158.0" prefHeight="39.0" prefWidth="209.0" text="User Name">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <TextField fx:id="userNameSignup" layoutX="346.0" layoutY="197.0" prefHeight="32.0" prefWidth="209.0" />
      <Label layoutX="346.0" layoutY="257.0" prefHeight="39.0" prefWidth="209.0" text="Password">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <PasswordField fx:id="passwordSignup" layoutX="346.0" layoutY="296.0" prefHeight="32.0" prefWidth="209.0" />
      <Button layoutX="403.0" layoutY="403.0" mnemonicParsing="false" onAction="#clickSignup" prefHeight="39.0" prefWidth="96.0" style="-fx-background-color: #ff582f; -fx-background-radius: 10;" text="Sign up" textFill="WHITE">
