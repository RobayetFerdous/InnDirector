      <Button layoutX="34.0" layoutY="20.0" mnemonicParsing="false" onAction="#clickNewCustomer" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #1f2327;" text="New Customer" textFill="WHITE">
