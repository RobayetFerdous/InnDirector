      <Button layoutX="34.0" layoutY="138.0" mnemonicParsing="false" onAction="#clickCheckOut" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #1f2327;" text="Check Out" textFill="WHITE">
